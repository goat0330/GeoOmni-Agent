# GeoOmni runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=4173

# DeepSeek (keep secrets outside Git)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled

# Source map/terrain fallback. Production defaults to disabled.
# Only enable for an explicitly authorized source environment.
ALLOW_SOURCE_PROXY=false
SOURCE_ORIGIN=
SOURCE_TLS_VERIFY=true

# HTTP hardening
TRUST_PROXY=true
REQUEST_BODY_LIMIT_BYTES=1048576
CHAT_RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=65000
KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Docker/Nginx local exposure
PUBLIC_PORT=8080
